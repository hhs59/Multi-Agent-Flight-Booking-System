server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Auth0 returns to these client-side routes; they must be handled by the SPA.
    location ~ ^/auth/(callback|silent-callback)$ {
        try_files $uri /index.html;
    }

    # Keep API calls on the frontend origin so the session cookie is first-party.
    location /auth/ {
        proxy_pass ${BACKEND_URL}/auth/;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 180s;
    }

    location /v1/ {
        proxy_pass ${BACKEND_URL}/v1/;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 180s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
