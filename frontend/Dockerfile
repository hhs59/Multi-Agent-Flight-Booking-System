FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG VITE_API_BASE_URL
ARG VITE_OIDC_AUTHORITY
ARG VITE_OIDC_CLIENT_ID
ARG VITE_OIDC_REDIRECT_URI
ARG VITE_OIDC_SILENT_REDIRECT_URI
ARG VITE_OIDC_POST_LOGOUT_REDIRECT_URI
ARG VITE_DEFAULT_LOCALE
ARG VITE_ENABLE_DEV_DIAGNOSTICS

ENV VITE_API_BASE_URL=${VITE_API_BASE_URL} \
    VITE_OIDC_AUTHORITY=${VITE_OIDC_AUTHORITY} \
    VITE_OIDC_CLIENT_ID=${VITE_OIDC_CLIENT_ID} \
    VITE_OIDC_REDIRECT_URI=${VITE_OIDC_REDIRECT_URI} \
    VITE_OIDC_SILENT_REDIRECT_URI=${VITE_OIDC_SILENT_REDIRECT_URI} \
    VITE_OIDC_POST_LOGOUT_REDIRECT_URI=${VITE_OIDC_POST_LOGOUT_REDIRECT_URI} \
    VITE_DEFAULT_LOCALE=${VITE_DEFAULT_LOCALE} \
    VITE_ENABLE_DEV_DIAGNOSTICS=${VITE_ENABLE_DEV_DIAGNOSTICS}

RUN npm run build

FROM node:22-alpine

WORKDIR /app
ENV NODE_ENV=production

RUN npm install --global serve@14.2.4 \
    && npm cache clean --force

COPY --from=build /app/dist ./dist

EXPOSE 4173

CMD ["sh", "-c", "exec serve --single --listen ${PORT:-4173} dist"]
