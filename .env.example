# PostgreSQL is mandatory outside isolated unit tests.
DATABASE_URL=postgresql+psycopg://flight:flight_dev_only@127.0.0.1:55432/flight

# Local Keycloak realm imported by compose.yaml.
IDENTITY_ENABLED=true
OIDC_ISSUER=http://localhost:8080/realms/flight-dev
OIDC_AUDIENCE=flight-api
OIDC_JWKS_URL=http://localhost:8080/realms/flight-dev/protocol/openid-connect/certs
OIDC_ALLOW_HTTP_FOR_LOCAL=true
OIDC_ALLOW_TEST_EMAIL_DOMAINS=true

# Generate each value independently:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
SESSION_TOKEN_PEPPER=replace-with-urlsafe-base64-32-byte-pepper
# Wrap an existing key value only; do not regenerate it while traveler snapshots exist.
PII_ENCRYPTION_KEYS='{"1":"replace-with-urlsafe-base64-32-byte-key"}'
PII_ACTIVE_KEY_VERSION=1

SESSION_COOKIE_NAME=flight_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_LIFETIME_HOURS=12
CORS_ORIGINS=http://localhost:5173

# Keep local development deterministic. In sandbox/production mode the server-side
# default flight provider is Duffel; set DUFFEL_ACCESS_TOKEN in that deployment.
EXECUTION_MODE=mock
FLIGHT_PROVIDER=mock
WEATHER_PROVIDER=mock
PAYMENT_PROVIDER=mock
NOTIFICATION_PROVIDER=mock
PLACES_PROVIDER=curated
PLACES_RECOMMENDATION_LIMIT=5
PLACES_RECOMMENDATION_MAX_CANDIDATES=20
PLACES_RECOMMENDATION_TIMEOUT_SECONDS=2
# Curated/fixture recommendation cache freshness window in seconds.
PLACES_CACHE_TTL_SECONDS=300
PLACES_CURATED_FALLBACK_ENABLED=false
LOCATION_PROVIDER=catalog
LOCATION_LOOKUP_LIMIT=8
LOCATION_CACHE_TTL_SECONDS=3600
LOCATION_CACHE_MAX_ENTRIES=512
INSPIRATION_MAX_CANDIDATES=5
INSPIRATION_MAX_FLIGHT_CALLS=10
INSPIRATION_CONCURRENCY=2
INSPIRATION_TIMEOUT_SECONDS=30
INSPIRATION_RESULT_LIMIT=3
# Advisory FX conversion for trip-inspiration comparisons; disabled by default.
# FX_PROVIDER=disabled
# FX_BASE_CURRENCY=USD
# FX_RATES_JSON={"USD":"1","VND":"25000","EUR":"0.92","AUD":"1.52"}
# FX_RATE_TTL_SECONDS=86400
PROVIDER_CONNECT_TIMEOUT_SECONDS=3
PROVIDER_READ_TIMEOUT_SECONDS=10
PROVIDER_TOTAL_TIMEOUT_SECONDS=15
PROVIDER_MAX_SAFE_RETRIES=2
PROVIDER_SEARCH_CACHE_MAX_ENTRIES=256
PROVIDER_PRODUCTION_APPROVED=false
# Required when FLIGHT_PROVIDER=duffel. Duffel test/live mode is selected by the token.
DUFFEL_ACCESS_TOKEN=
DUFFEL_ORDER_ENABLED=false
DUFFEL_ORDER_TIMEOUT_SECONDS=130
DUFFEL_SETTLEMENT_MODE=balance
OPENWEATHERMAP_API_KEY=

# Server-owned rollout controls. Keep every flag false until its phase has passed
# verification and a later rollout gate explicitly authorizes enabling it.
TRAVEL_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
TRIP_DISCOVERY_ENABLED=false
FLEXIBLE_SEARCH_ENABLED=false
DISCOVERY_MAX_DAYS=7
DISCOVERY_MAX_CALLS=14
DISCOVERY_CONCURRENCY=3
DISCOVERY_TIMEOUT_SECONDS=20
FLIGHT_RANKING_ENABLED=false
TRAVEL_PREFERENCES_ENABLED=false
DESTINATION_RECOMMENDATIONS_ENABLED=false
PLACES_LLM_RANKING_ENABLED=false
PLACES_LLM_GENERATION_ENABLED=false
DYNAMIC_LOCATION_RESOLUTION_ENABLED=false
TRIP_INSPIRATION_ENABLED=false
LLM_SEMANTIC_UPDATES_ENABLED=false

# Retention worker safety bound.
SEARCH_RETENTION_BATCH_SIZE=500

# Phase 5 model planner. fixture is deterministic/offline. groq and
# openai_compatible use the OpenAI chat-completions wire format.
LLM_PROVIDER=fixture
LLM_MODEL=rule-v1
LLM_BASE_URL=
LLM_API_KEY=
GROQ_API_KEY=
LLM_TIMEOUT_SECONDS=20

# Phase 6 order gate. Keep disabled until provider sandbox, POS, ticketing,
# payment settlement, and cancellation ownership are verified.
BOOKING_ORDER_ENABLED=false
BOOKING_PRODUCTION_APPROVED=false
BOOKING_SANDBOX_CONTRACT_VERIFIED=false
BOOKING_POINT_OF_SALE_APPROVED=false
BOOKING_TICKETING_AGREEMENT_CONFIRMED=false
BOOKING_PAYMENT_COLLECTION_APPROVED=false
BOOKING_CANCELLATION_OWNER_ASSIGNED=false

# Phase 7: background watch worker runs separately from FastAPI.
WATCH_WORKER_INTERVAL_SECONDS=900
WATCH_WORKER_LEASE_SECONDS=120
WATCH_WORKER_POLL_SECONDS=5
# Auto-buy is disabled unless every server-side readiness flag is true.
AUTO_BUY_ENABLED=false
AUTO_BUY_PROVIDER_ORDER_READY=false
AUTO_BUY_OFF_SESSION_PAYMENT_READY=false
AUTO_BUY_MANDATE_TERMS_REVIEWED=false
AUTO_BUY_SANDBOX_FAULT_TESTS_PASSED=false
AUTO_BUY_DUPLICATE_RATE_ZERO=false
AUTO_BUY_SPEND_LIMITS_CONFIGURED=false
AUTO_BUY_MONITORING_READY=false
AUTO_BUY_OPERATOR_READY=false
AUTO_BUY_PILOT_APPROVED=false
AUTO_BUY_KILL_SWITCH=false
AUTO_BUY_GLOBAL_SPEND_LIMIT=0
AUTO_BUY_PER_USER_SPEND_LIMIT=0
AUTO_BUY_PER_WATCH_SPEND_LIMIT=0
